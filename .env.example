# Ticketsystem Nils-Digital — Vorlage für .env
#
# Kopieren nach .env (macht bin/start automatisch), dann anpassen.
# Die echte .env ist gitignored und wird bei keinem Deploy überschrieben.

APP_NAME="Nils-Digital Ticketsystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Deutsch als Oberflächensprache, auch für Datums- und Zahlenformate.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Nicht optional: Fälligkeiten und Zeiterfassung rechnen sonst in UTC,
# und eine um 23:30 Uhr gestartete Zeitbuchung landet auf dem Folgetag.
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Datenbank ---------------------------------------------------------
#
# Lokal: eigener Postgres-Container auf Port 5433 (5432 ist vom
# Landhaus-Projekt belegt). Hochfahren mit:
#   podman start ticketsystem-postgres
#
# Auf dem VPS: DB_HOST=postgres und DB_PORT=5432 — dort wird der Container
# n8n-postgres-1 über das Docker-Netz n8n_default unter dem Namen
# "postgres" erreicht, und zwar mit einem EIGENEN DB-User, damit n8n nicht
# an die Ticketdaten kommt und umgekehrt.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ticketsystem
DB_USERNAME=ticketsystem
DB_PASSWORD=ticketsystem_dev

# --- Session -----------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# VOR GO-LIVE auf true setzen. Ohne das wird das Session-Cookie auch über
# unverschlüsselte Verbindungen mitgeschickt. (In kein-einzelfall steht
# genau dieser Punkt bis heute offen auf der Übergabe-Checkliste.)
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Mail --------------------------------------------------------------
# Lokal schreibt "log" die Mails nach storage/logs/laravel.log statt sie
# zu verschicken. Produktiv später entweder Strato-SMTP oder der Versand
# über n8n.
# Mailversand. "log" schreibt jede Mail nur nach storage/logs/laravel.log —
# gut zum Ausprobieren, es geht nichts hinaus. Für echten Versand:
# MAIL_MAILER=smtp und die vier Zeilen darunter ausfüllen.
MAIL_MAILER=log
# MAIL_HOST=smtp.strato.de
# MAIL_PORT=587
# MAIL_USERNAME=info@nils-digital.de
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# Der Absender muss zum angemeldeten Postfach passen, sonst weist Strato ab.
MAIL_FROM_ADDRESS="info@nils-digital.de"
MAIL_FROM_NAME="${APP_NAME}"

# --- Schnittstelle für n8n --------------------------------------------
# Token für POST /api/v1/tickets (Header: Authorization: Bearer <TOKEN>).
# Erzeugen mit:  php artisan ticket:token
TICKET_API_TOKEN=

# --- Kundenbereich ----------------------------------------------------
# Steht auf der Kontaktseite unter /kunde. Ohne KONTAKT_TELEFON erscheint dort
# schlicht keine Telefonnummer — besser als eine falsche.
KONTAKT_EMAIL="info@nils-digital.de"
KONTAKT_TELEFON=
KONTAKT_WEBSITE="https://nils-digital.de"

# Wie oft die Glocke nachfragt — in beiden Bereichen. Leer lassen für die
# Vorgabe (30s). "null" schaltet das Nachfragen ab, dann aktualisiert sie
# sich nur noch beim Seitenwechsel.
GLOCKE_TAKT=30s

# Muster für den Vorschlag der Vorschau-Adresse im Projektformular.
# {projekt} wird durch das Kürzel des Projekts ersetzt. Leer lassen, wenn
# der Vorschlagsknopf verschwinden soll — die Adresse selbst steht immer am
# Projekt und wird von diesem Wert nie überschrieben.
DEMO_MUSTER="{projekt}.nils-digital.de"

VITE_APP_NAME="${APP_NAME}"
